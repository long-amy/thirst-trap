# Firebase web app config. These are safe to expose in the client bundle —
# they identify the project, they don't authorize anything. Access is controlled
# by firestore.rules and storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair, from Firebase Console → Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=

# NOTE: the Anthropic API key is deliberately NOT here.
# Every VITE_-prefixed variable is inlined into the client bundle at build time,
# so anything secret placed in this file ends up public. The Claude call runs in
# a Cloud Function instead, with the key in Google Secret Manager:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
